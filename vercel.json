{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist/public" }
    },
    { "src": "server/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "findmyfuel.site" }],
      "status": 308,
      "headers": { "Location": "https://www.findmyfuel.site/$1" }
    },
    { "handle": "filesystem" },
    { "src": "/api/(.*)", "dest": "server/index.ts" },
    { "src": "/calculator/?", "dest": "/calculator/index.html" },
    { "src": "/about/?", "dest": "/about/index.html" },
    { "src": "/contact/?", "dest": "/contact/index.html" },
    { "src": "/privacy/?", "dest": "/privacy/index.html" },
    { "src": "/terms/?", "dest": "/terms/index.html" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
